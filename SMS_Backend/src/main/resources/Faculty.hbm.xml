<?xml version="1.0" encoding="UTF-8"?>

<hibernate-mapping>

    <class name="com.example.demo.model.Faculty"
           table="faculty">

        <id name="teacherId" column="teacher_id">
            <generator class="assigned"/>
        </id>

        <property name="name"
                  column="name"
                  not-null="true"/>

        <property name="phoneNumber"
                  column="phone_number"/>

        <property name="alternatePhoneNumber"
                  column="alternate_phone_number"/>

        <property name="educationalDetails"
                  column="educational_details"/>

        <property name="email"
                  column="email"/>

        <property name="facultyType"
                  column="faculty_type"
                  not-null="true"/>

        <property name="deptId"
                  column="dept_id"/>

        <property name="status"
                  column="status"
                  not-null="true"/>

    </class>

</hibernate-mapping>
